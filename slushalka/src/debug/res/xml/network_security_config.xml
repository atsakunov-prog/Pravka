<?xml version="1.0" encoding="utf-8"?>
<!-- Только отладочная сборка: эмулятор ходит к проверочной копии сервера на компе
     (10.0.2.2 - это компьютер для эмулятора) обычным http. В релиз не попадает. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
