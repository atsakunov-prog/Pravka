<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Playback must survive a dozing screen: an audiobook runs for hours
         with the phone in a pocket. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Обновление изнутри приложения: скачанный APK отдаётся системному
         установщику. Ключ подписи тот же, поэтому данные переживают установку. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 11+ hides other apps from us; without these the question box
         reports "распознавание недоступно" and the answer never speaks. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".SlushalkaApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Slushalka"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:theme="@style/Theme.Slushalka">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Возврат из браузера после входа в семейный Google Drive
             (data/GoogleAuth.kt): Android-клиент Google отдаёт код на адрес
             со схемой-пакетом. Своего окна нет. -->
        <activity
            android:name=".GoogleAuthActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ru.zf.slushalka" android:path="/oauth2redirect" />
            </intent-filter>
        </activity>

        <!-- MediaSessionService, not a bare foreground service: it is what
             puts the cover on the lock screen, wires the headset buttons and
             keeps Android from reclaiming playback mid-chapter. -->
        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <!-- Озвучка книги без записи системным синтезом речи. Своя служба, а
             не PlaybackService: тот держит ExoPlayer с файлами, а здесь звук
             рождает движок TTS. Передний план - чтобы чтение не обрывалось,
             когда экран погас и приложение свёрнуто. -->
        <service
            android:name=".speech.ReadAloudService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- Виджет «Продолжить» на главный экран: последняя книга, одним тапом. -->
        <receiver
            android:name=".widget.ContinueWidget"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_continue_info" />
        </receiver>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="ru.zf.slushalka.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
