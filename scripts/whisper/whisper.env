# Настройки локального распознавателя Правки.
# Читаются server.py при старте; переменные окружения, если заданы, главнее.

PRAVKA_WHISPER_HOST=127.0.0.1
PRAVKA_WHISPER_PORT=8178

# Модель по умолчанию - для диктовки. turbo распознаёт короткую фразу
# за доли секунды при качестве, близком к large-v3.
PRAVKA_WHISPER_MODEL=large-v3-turbo
PRAVKA_WHISPER_PRELOAD=large-v3-turbo

PRAVKA_WHISPER_DEVICE=cuda
# float16 - быстрее; int8_float16 - вдвое меньше видеопамяти, качество почти то же.
PRAVKA_WHISPER_COMPUTE=float16

# turbo для диктовки + large-v3 для встреч живут в памяти одновременно.
PRAVKA_WHISPER_MAX_LOADED=2
PRAVKA_WHISPER_BEAM=5
PRAVKA_WHISPER_LANG=ru
