# Настройки локального распознавателя Правки.
# Читаются server.py при старте; переменные окружения, если заданы, главнее.

PRAVKA_WHISPER_HOST=127.0.0.1
PRAVKA_WHISPER_PORT=8178

# Модель для диктовки. turbo распознаёт короткую фразу за доли секунды при
# качестве, близком к large-v3. Большую модель здесь держать не надо: встречи
# разбирает бот своей, а видеопамять у нас общая.
PRAVKA_WHISPER_MODEL=large-v3-turbo
PRAVKA_WHISPER_PRELOAD=large-v3-turbo

PRAVKA_WHISPER_DEVICE=cuda
# int8_float16 - примерно 1.2 ГБ видеопамяти вместо 2.3 у float16. На карте,
# где уже висит модель бота, это разница между «влезло» и «не влезло».
PRAVKA_WHISPER_COMPUTE=int8_float16

# Куда отступать, если видеопамяти не хватило: диктовка обязана уступать
# разбору встреч, а не падать и не ломать его.
PRAVKA_WHISPER_FALLBACK_DEVICE=cpu
PRAVKA_WHISPER_FALLBACK_COMPUTE=int8

# Одна модель: вторая копия на этой карте не поместится.
PRAVKA_WHISPER_MAX_LOADED=1

# Луч 1 - для коротких фраз. Для длинной записи beam_size можно прислать
# в самом запросе.
PRAVKA_WHISPER_BEAM=1
PRAVKA_WHISPER_LANG=ru
