<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Маршрут микрофона: поднять и опустить канал гарнитуры, попросить
         встроенный вход, снять заглушку. Без этого разрешения система НЕ
         ругается - она молча отказывает (AudioService пишет в свой лог
         "Audio Settings Permission Denial" и возвращает управление), и
         выглядит это ровно как "в машине Правка меня не слышит": канал
         хендс-фри остаётся поднятым, распознаватель слушает салонный
         микрофон у лобового. Разрешение обычное, спрашивать нечего -
         выдаётся при установке (22.09.2026). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keep the CPU awake during dictation so recognition doesn't stall if
         the device would otherwise doze. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Засечка, телефонный слой: статистика использования приложений
         (спец-доступ, выдаётся в настройках) и журнал звонков - звонки
         вставляются в ленту как прерывания с продолжением дела. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Автопилот Засечки: имя Wi-Fi-сети система отдаёт только с
         местоположением (GPS при этом не включается), имя BT-устройства
         на Android 12+ — только с «устройствами поблизости». -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Приезд ловит служба доступности, из фона. С разрешением «только при
         использовании приложения» система отдаёт ей «<unknown ssid>», и
         автопилот молчит - выглядит как поломка. Нужно «Разрешать всегда». -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Места «по видимости» (сеть в Летово, к которой не подключаются):
         скан эфира на Android 13+ требует «Устройства поблизости». -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- Android 11+ package visibility hides other apps' names from us; the
         phone-time list needs real labels ("Telegram", not "messenger.web").
         Personal app, no Play Store - the blanket permission is the fix. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Самообновление: приложение тянет APK из ветки apk-builds и открывает
         системный установщик. Подпись у всех сборок одна, поэтому обновление
         ставится поверх и данные остаются на месте. -->
    <!-- Метки NFC: наклейка в туалете, на велике, в машине - касание ставит
         засечку без телефона в руках. Не required: без NFC работает всё
         остальное. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- База в папке Documents/Pravka (24.09.2026): владелец копирует её
         руками, а приложение после переустановки или на другом телефоне
         должно прочитать базу, которую само не создавало. Своими система
         считает только файлы этой же установки, поэтому Android 11+ —
         «Доступ ко всем файлам» (выдаётся владельцем в настройках, по кнопке
         в «Настройки → База данных»); до Android 10 — обычная запись.
         Личное приложение, не Play Store: особое разрешение уместно. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Needed to see (and bind) the system speech recognition service on
         Android 11+; without it SpeechRecognizer reports "unavailable". -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".PravkaApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Pravka"
        android:allowBackup="true"
        android:requestLegacyExternalStorage="true">

        <!-- Штрихкод еды: просим Play Services подтянуть модуль сканера при
             установке, а не при первом сканировании. Иначе первый скан в
             магазине упирается в загрузку по мобильной сети. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Кнопка «Вернуться в Правку» на странице после входа в Google
                 (provider/GoogleAuth.kt): просто поднимает приложение. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pravka" android:host="google" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="ru.zf.pravka.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".trigger.PravkaAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/app_name"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".trigger.PravkaTileService"
            android:label="@string/app_name"
            android:icon="@drawable/ic_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <activity
            android:name=".trigger.QuickActionActivity"
            android:theme="@style/Theme.Transparent"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="false" />

        <activity
            android:name=".trigger.MicPermissionActivity"
            android:theme="@style/Theme.Transparent"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="false" />

        <!-- Трамплин за разрешением на уведомления: служба замечает, что они
             выключены (после обновления), а спросить умеет только Activity. -->
        <activity
            android:name=".trigger.NotifPermissionActivity"
            android:theme="@style/Theme.Transparent"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="false" />

        <!-- Трамплин за уведомлением об обновлении. -->
        <activity
            android:name=".trigger.UpdateActivity"
            android:theme="@style/Theme.Transparent"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="false" />

        <activity
            android:name=".trigger.ZasechkaQuickActivity"
            android:theme="@style/Theme.Transparent"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="false" />

        <activity
            android:name=".trigger.SportQuickActivity"
            android:theme="@style/Theme.Transparent"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="false" />

        <activity
            android:name=".trigger.AutoPilotActivity"
            android:theme="@style/Theme.Transparent"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="false" />

        <!-- Касание метки. exported=true обязательно: intent приносит система
             NFC. Свой MIME-тип плюс AAR внутри сообщения - открывает только
             Правка, чужие метки нас не касаются. taskAffinity пустой, чтобы
             трамплин не подменял собой главное окно в списке задач.
             showWhenLocked - вся суть метки: приложил на заблокированном
             телефоне и пошёл. Без него система держит intent до разблокировки
             (а на части прошивок молча бросает), и касание «не срабатывает». -->
        <activity
            android:name=".trigger.NfcTapActivity"
            android:theme="@style/Theme.Transparent"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.pravka" />
            </intent-filter>
        </activity>

        <service
            android:name=".trigger.DictationService"
            android:foregroundServiceType="microphone"
            android:exported="false" />

        <!-- «Разноска» в меню выделения: выделенный текст разбирается на дела. -->
        <activity
            android:name=".trigger.ProcessTasksActivity"
            android:label="@string/action_label_tasks"
            android:theme="@style/Theme.Transparent"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Деньги: «Поделиться» выпиской Тинькова/Альфы (CSV) или текстом чата
             «Плати по миру». Своя подпись в листе «Поделиться», чтобы не путать
             с Правкой; несколько файлов разом — недельный пакет. -->
        <activity
            android:name=".trigger.MoneyShareActivity"
            android:label="@string/money_share_label"
            android:theme="@style/Theme.Transparent"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/csv" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
            </intent-filter>
        </activity>

        <!-- Деньги: пуши Т-Банка и чата «Плати по миру» → журнал. Своя служба,
             не служба доступности (Fold: на оконные события не подписываемся);
             доступ выдаёт владелец в «Доступе к уведомлениям». -->
        <service
            android:name=".trigger.MoneyNotificationListener"
            android:label="@string/money_push_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <activity
            android:name=".trigger.ProcessTextActivity"
            android:label="@string/action_label"
            android:theme="@style/Theme.Transparent"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

    </application>

</manifest>
