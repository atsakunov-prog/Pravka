<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет Засечки: 4×4 с завода («Пульт»: категории, полоса суток, лента, кнопки — 08.11.2026),
     растягивается от строки до широкого в две колонки; что влезает — `core/ZWidget.plan`.
     Минуты тикает само приложение (`ZasechkaWidget.watch`) — раз в минуту к
     смене числа; полчаса здесь — страховка, если процесс система усыпила. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_z_desc"
    android:initialLayout="@layout/widget_zasechka"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:previewLayout="@layout/widget_zasechka"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
