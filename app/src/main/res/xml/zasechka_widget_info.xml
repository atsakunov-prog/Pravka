<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет Засечки: 4×2 с завода, растягивается от строки до высокого.
     Минуты тикает само приложение (`ZasechkaWidget.watch`) — раз в минуту к
     смене числа; полчаса здесь — страховка, если процесс система усыпила. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_z_desc"
    android:initialLayout="@layout/widget_zasechka"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:previewLayout="@layout/widget_zasechka"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
