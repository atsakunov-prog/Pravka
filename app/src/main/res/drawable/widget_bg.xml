<?xml version="1.0" encoding="utf-8"?>
<!-- Фон виджета Засечки: чернила приложения (оно всегда тёмное), сверху —
     янтарный свет режима, как над вкладкой Засечки (`ui/Glow.kt`). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
