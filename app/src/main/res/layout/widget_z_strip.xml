<?xml version="1.0" encoding="utf-8"?>
<!-- Полоса суток на виджете Засечки: от полуночи до полуночи, прожитое — цветами категорий (картинка
     `ZasechkaWidget.strip`, только сама полоса — так она лёгкая для ежеминутной перерисовки), под ней часы
     текстом. Подписи расставлены равными промежутками — у четвертей суток с точностью до полцифры. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_strip_box"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/w_strip"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">

        <TextView style="@style/WidgetHour" android:text="0" />
        <FrameLayout style="@style/WidgetHourGap" />
        <TextView style="@style/WidgetHour" android:text="6" />
        <FrameLayout style="@style/WidgetHourGap" />
        <TextView style="@style/WidgetHour" android:text="12" />
        <FrameLayout style="@style/WidgetHourGap" />
        <TextView style="@style/WidgetHour" android:text="18" />
        <FrameLayout style="@style/WidgetHourGap" />
        <TextView style="@style/WidgetHour" android:text="24" />
    </LinearLayout>
</LinearLayout>
