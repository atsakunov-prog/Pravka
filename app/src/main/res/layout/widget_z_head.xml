<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет Засечки: что идёт — кружок «З» (тейк), название и подпись (лента), минуты. Общий для всех раскладок. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_head"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/w_face_box"
        android:layout_width="46dp"
        android:layout_height="46dp">

        <ImageView
            android:id="@+id/w_face"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_z_say"
            android:src="@drawable/widget_face" />

        <ImageView
            android:id="@+id/w_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_zfab_glyph" />

        <!-- Узкий виджет: минуты в самом кружке, под значком, как на «З». -->
        <TextView
            android:id="@+id/w_face_min"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="5dp"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="#FFF7F3EA"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/w_text_box"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_z_preview_title"
            android:textColor="#FFF2ECE2"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_z_preview_sub"
            android:textColor="#FFA8998A"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_min_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_min"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:text="25"
            android:textColor="#FFFFA640"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_z_min"
            android:textColor="#FFA8998A"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
