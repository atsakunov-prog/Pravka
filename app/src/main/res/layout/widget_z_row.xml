<?xml version="1.0" encoding="utf-8"?>
<!-- Строка ленты на виджете Засечки: черта цвета категории (светофор цены часа, как в ленте), начало,
     название, длительность. Касание — Засечка в приложении. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_row"
    android:layout_width="match_parent"
    android:layout_height="26dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/w_row_bar"
        android:layout_width="4dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_bar" />

    <TextView
        android:id="@+id/w_row_time"
        android:layout_width="38dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#FFA8998A"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/w_row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#FFF2ECE2"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/w_row_min"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#FFA8998A"
        android:textSize="12sp" />
</LinearLayout>
