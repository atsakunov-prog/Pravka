<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет Засечки «Пульт» (11.10.2026, кнопки и лента — 08.11.2026, `trigger/ZasechkaWidget.kt`): что идёт
     (кружок «З» — тейк, текст — лента), полоса суток, категории плитками по частоте (касание — «переключить
     на …»), последние куски ленты, ряд кнопок: сменить голосом, мысль, еда снимком, из галереи, текстом,
     «Сегодня». Что видно и сколько — решает размер (`core/ZWidget.plan`); растянутый вширь —
     `widget_zasechka_wide.xml`. Тексты по умолчанию — для превью в списке виджетов. Лента забирает остаток
     высоты (вес 1), ряд кнопок — всегда внизу: не хватило места — обрежется лента, а не кнопки. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <include
        layout="@layout/widget_z_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        layout="@layout/widget_z_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />

    <LinearLayout
        android:id="@+id/w_cats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/w_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <include
        layout="@layout/widget_z_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />
</LinearLayout>
